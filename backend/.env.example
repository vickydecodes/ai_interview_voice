# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=levelup_interview

# JWT Authentication
JWT_SECRET=levelup-super-secret-jwt-key-change-in-production-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Options: "claude", "openai", "gemini", "mock"
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Voice Providers (Default is "webspeech" which runs in-browser with zero keys)
# Options for STT: "webspeech", "whisper", "deepgram"
STT_PROVIDER=webspeech
DEEPGRAM_API_KEY=

# Options for TTS: "webspeech", "elevenlabs"
TTS_PROVIDER=webspeech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
